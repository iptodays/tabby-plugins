{
  "name": "tabby-ssh-notes",
  "version": "0.1.0",
  "description": "Local SSH connection notes for Tabby: searchable notes, terminal title integration and import/export.",
  "keywords": [
    "tabby-plugin",
    "tabby",
    "ssh",
    "notes"
  ],
  "main": "dist/index.js",
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "npm run clean && webpack --mode production",
    "build:dev": "webpack --mode development",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "pack": "npm run build && npm pack",
    "dev:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-dev.ps1",
    "dev:uninstall": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/uninstall-dev.ps1",
    "doctor": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/diagnose.ps1"
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "author": "Tabby SSH Notes contributors",
  "license": "MIT",
  "peerDependencies": {
    "@angular/animations": "^15",
    "@angular/common": "^15",
    "@angular/core": "^15",
    "@angular/forms": "^15",
    "@angular/platform-browser": "^15",
    "@angular/platform-browser-dynamic": "^15",
    "@ng-bootstrap/ng-bootstrap": "^14",
    "rxjs": "^7",
    "tabby-core": "*",
    "tabby-settings": "*",
    "tabby-terminal": "*"
  },
  "devDependencies": {
    "@angular/animations": "15.2.10",
    "@angular/cdk": "15.2.9",
    "@angular/common": "15.2.10",
    "@angular/compiler": "15.2.10",
    "@angular/compiler-cli": "15.2.10",
    "@angular/core": "15.2.10",
    "@angular/forms": "15.2.10",
    "@angular/localize": "15.2.10",
    "@angular/platform-browser": "15.2.10",
    "@angular/platform-browser-dynamic": "15.2.10",
    "@ng-bootstrap/ng-bootstrap": "14.2.0",
    "@types/jest": "29.5.12",
    "@types/node": "22.10.2",
    "@types/ssh2": "^1.15.1",
    "@types/webpack-env": "1.18.5",
    "jest": "29.7.0",
    "jest-environment-jsdom": "29.7.0",
    "ngx-toastr": "16.2.0",
    "rxjs": "7.8.1",
    "ssh2": "^1.16.0",
    "tabby-core": "1.0.231-nightly.0",
    "tabby-settings": "1.0.231-nightly.0",
    "tabby-terminal": "1.0.231-nightly.0",
    "ts-jest": "29.1.2",
    "ts-loader": "9.5.1",
    "typescript": "4.9.5",
    "webpack": "5.89.0",
    "webpack-cli": "5.1.4",
    "zone.js": "0.12.0"
  }
}
